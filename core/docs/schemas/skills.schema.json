{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-runtime-kit.local/schemas/skills.schema.json",
  "title": "skills.yaml",
  "description": "Active renderable skill manifest. Invocation semantics and product exposure are explicit; pending migration entries remain visibly installed until disposition review completes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skills"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "migration": {
      "$ref": "#/$defs/migration"
    },
    "skills": {
      "type": "array",
      "items": { "$ref": "#/$defs/skill" }
    }
  },
  "$defs": {
    "skillId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$"
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "pending_disposition"],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1,
          "description": "Durable issue or plan that owns the pending migration set."
        },
        "pending_disposition": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/skillId" }
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "intents", "example_request", "admission_rationale"],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["workflow", "maintenance", "advanced", "compatibility"]
        },
        "intents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "example_request": {
          "type": "string",
          "minLength": 1,
          "description": "A direct user request that justifies this discoverable entrypoint."
        },
        "admission_rationale": {
          "type": "string",
          "minLength": 1,
          "description": "Why this capability is a user outcome rather than agent bookkeeping or a child workflow phase."
        }
      }
    },
    "exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": {
          "type": "string",
          "const": "default",
          "description": "The only product-real exposure profile currently supported across Codex, Claude, and Hermes."
        },
        "replacement": { "$ref": "#/$defs/skillId" },
        "retire_after": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "domain", "source", "products", "required_clis"],
      "properties": {
        "id": { "$ref": "#/$defs/skillId" },
        "domain": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "source": { "type": "string", "minLength": 1 },
        "invocation": { "$ref": "#/$defs/invocation" },
        "exposure": { "$ref": "#/$defs/exposure" },
        "products": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "codex": { "$ref": "#/$defs/productRender" },
            "claude": { "$ref": "#/$defs/productRender" },
            "hermes": { "$ref": "#/$defs/productRender" }
          }
        },
        "required_clis": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "state_out_mode": {
          "type": "string",
          "enum": ["runtime", "literal"],
          "default": "runtime"
        },
        "aliases": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "divergent": {
          "type": "boolean",
          "default": false
        },
        "portability_notes": { "type": "string" }
      },
      "allOf": [
        {
          "oneOf": [
            { "required": ["invocation", "exposure"] },
            {
              "not": {
                "anyOf": [
                  { "required": ["invocation"] },
                  { "required": ["exposure"] }
                ]
              }
            }
          ]
        },
        {
          "not": {
            "properties": {
              "invocation": {
                "properties": { "role": { "const": "advanced" } },
                "required": ["role"]
              }
            },
            "required": ["invocation"]
          }
        },
        {
          "if": {
            "properties": {
              "invocation": {
                "properties": { "role": { "const": "compatibility" } },
                "required": ["role"]
              }
            },
            "required": ["invocation"]
          },
          "then": {
            "properties": {
              "exposure": { "required": ["replacement", "retire_after"] }
            }
          },
          "else": {
            "properties": {
              "exposure": {
                "not": {
                  "anyOf": [
                    { "required": ["replacement"] },
                    { "required": ["retire_after"] }
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "productRender": {
      "type": "object",
      "additionalProperties": false,
      "required": ["render_to"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "render_to": { "type": "string", "minLength": 1 },
        "path_override": { "type": "string", "minLength": 1 }
      }
    }
  }
}
