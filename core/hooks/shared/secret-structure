#!/usr/bin/env python3
"""Print syntactic configuration names and a count, never their values."""
from __future__ import annotations

import re
import sys
from pathlib import Path

ASSIGNMENT = re.compile(r"^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_.-]*)\s*[:=]\s*([^=\s].*)$")
DIRECTIVES = frozenset({"Address", "DNS", "Endpoint", "ListenPort", "PrivateKey", "PublicKey", "AllowedIPs"})


def unbalanced_quotes(text: str) -> bool:
    quote = None
    for char in text:
        if quote:
            if char == quote:
                quote = None
        elif char in "\"'":
            quote = char
        elif char == "#":
            break
    return quote is not None


def uncertain(line: str) -> bool:
    stripped = line.lstrip()
    if not stripped or stripped.startswith("#"):
        return False
    if line[0].isspace() and stripped.strip():
        return True
    if any(marker in line for marker in ("<<", "$(", "`", "<(", ">(", '"""', "'''", "{", "[", "(", ")")):
        return True
    text = line.rstrip("\r\n")
    trailing_backslashes = len(text) - len(text.rstrip(chr(92)))
    if re.search(r"\\[\"']", line) or trailing_backslashes % 2 or unbalanced_quotes(line):
        return True
    if re.match(r"^\s*<[A-Za-z][A-Za-z0-9_.-]*>", line):
        return True
    match = ASSIGNMENT.match(line)
    if match:
        return bool(re.match(r"^[|>](?:[1-9][+-]?|[+-][1-9]?)?(?:\s*(?:#.*)?)?$", match.group(2)))
    parts = line.split(None, 1)
    return len(parts) != 2 or parts[0] not in DIRECTIVES


def main() -> int:
    if len(sys.argv) != 2:
        print("usage: secret-structure <file>", file=sys.stderr)
        return 2
    names: set[str] = set()
    count = 0
    suppressed = False
    try:
        with Path(sys.argv[1]).open(encoding="utf-8", errors="replace") as source:
            for line in source:
                count += 1
                if suppressed:
                    continue
                if uncertain(line):
                    names.clear()
                    suppressed = True
                    continue
                match = ASSIGNMENT.match(line)
                if match:
                    names.add(match.group(1))
                else:
                    parts = line.split(None, 1)
                    if len(parts) == 2 and parts[0] in DIRECTIVES:
                        names.add(parts[0])
    except OSError:
        print("secret-structure: could not read file", file=sys.stderr)
        return 1
    print(f"lines: {count}")
    if suppressed:
        print("structure suppressed: uncertain construct")
        return 0
    for name in sorted(names):
        print(name)
    return 0


if __name__ == "__main__":
    sys.exit(main())
