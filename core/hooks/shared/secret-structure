#!/usr/bin/env python3
"""Print syntactic configuration names and a count, never their values."""
from __future__ import annotations

import re
import sys
from pathlib import Path

ASSIGNMENT = re.compile(r"^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_.-]*)\s*[:=]\s*([^=\s].*)$")
DIRECTIVES = frozenset({"Address", "DNS", "Endpoint", "ListenPort", "PrivateKey", "PublicKey", "AllowedIPs"})


def quote_state(text: str, quote: str | None) -> str | None:
    escaped = False
    for char in text:
        if escaped:
            escaped = False
        elif char == "\\" and quote != "'":
            escaped = True
        elif quote:
            if char == quote:
                quote = None
        elif char in "\"'":
            quote = char
        elif char == "#":
            break
    return quote


def continues(line: str) -> bool:
    text = line.rstrip("\r\n")
    return (len(text) - len(text.rstrip("\\"))) % 2 == 1


def main() -> int:
    if len(sys.argv) != 2:
        print("usage: secret-structure <file>", file=sys.stderr)
        return 2
    names: set[str] = set()
    count = 0
    quote = None
    block_indent = None
    inline_block = None
    continuation = False
    try:
        with Path(sys.argv[1]).open(encoding="utf-8", errors="replace") as source:
            for line in source:
                count += 1
                if inline_block:
                    if re.fullmatch(r"\s*</" + re.escape(inline_block) + r">\s*", line):
                        inline_block = None
                    continue
                if continuation:
                    quote = quote_state(line, quote)
                    continuation = continues(line)
                    continue
                if quote:
                    quote = quote_state(line, quote)
                    continue
                indent = len(line) - len(line.lstrip())
                if block_indent is not None:
                    if not line.strip() or indent > block_indent:
                        continue
                    block_indent = None
                inline = re.fullmatch(r"\s*<([A-Za-z][A-Za-z0-9_.-]*)>\s*", line)
                if inline:
                    inline_block = inline.group(1)
                    continue
                continuation = continues(line)
                match = ASSIGNMENT.match(line)
                if match:
                    names.add(match.group(1))
                    quote = quote_state(match.group(2), None)
                    if re.match(r"^[|>](?:[1-9][+-]?|[+-][1-9]?)?(?:\s*(?:#.*)?)?$", match.group(2)):
                        block_indent = indent
                else:
                    parts = line.split(None, 1)
                    if len(parts) == 2 and parts[0] in DIRECTIVES:
                        names.add(parts[0])
                        quote = quote_state(parts[1], None)
                    elif not line.lstrip().startswith("#"):
                        quote = quote_state(line, None)
    except OSError:
        print("secret-structure: could not read file", file=sys.stderr)
        return 1
    print(f"lines: {count}")
    for name in sorted(names):
        print(name)
    return 0


if __name__ == "__main__":
    sys.exit(main())
