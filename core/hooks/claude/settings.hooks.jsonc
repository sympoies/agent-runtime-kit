// Claude settings hook fragment. This is a source artifact, not a whole
// settings.json replacement.
"hooks": {
  "UserPromptSubmit": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "AGENT_RUNTIME_PRODUCT=claude \"$HOME/.claude/hooks/user-prompt-agent-docs.sh\"",
          "statusMessage": "agent-runtime-kit: Remind agent-docs preflight"
        },
        {
          "type": "command",
          "command": "AGENT_RUNTIME_PRODUCT=claude \"$HOME/.claude/hooks/checkout-lease-guard.py\"",
          "statusMessage": "agent-runtime-kit: Offer governed dirty checkout adoption"
        },
        {
          "type": "command",
          "command": "AGENT_RUNTIME_PRODUCT=claude \"$HOME/.claude/hooks/skill-usage-reminder.py\"",
          "statusMessage": "agent-runtime-kit: Remind skill-usage recording"
        }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "AGENT_RUNTIME_PRODUCT=claude \"$HOME/.claude/hooks/stop-pre-pr-reminder.sh\"",
          "statusMessage": "agent-runtime-kit: Remind delivery readiness"
        },
        {
          "type": "command",
          "command": "AGENT_RUNTIME_PRODUCT=claude \"$HOME/.claude/hooks/agent-scope-lock-guard.py\"",
          "statusMessage": "agent-runtime-kit: Report scope lock violations"
        },
        {
          "type": "command",
          "command": "AGENT_RUNTIME_PRODUCT=claude \"$HOME/.claude/hooks/checkout-lease-guard.py\"",
          "statusMessage": "agent-runtime-kit: Audit checkout writer lease"
        },
        {
          "type": "command",
          "command": "AGENT_RUNTIME_PRODUCT=claude \"$HOME/.claude/hooks/session-coordination-guard.py\"",
          "statusMessage": "agent-runtime-kit: Audit managed operation completion"
        },
        {
          "type": "command",
          "command": "AGENT_RUNTIME_PRODUCT=claude \"$HOME/.claude/hooks/stop-finish-line-gate.py\"",
          "statusMessage": "agent-runtime-kit: Enforce agent-docs validation gate"
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "matcher": "startup|resume|clear",
      "hooks": [
        {
          "type": "command",
          "command": "AGENT_RUNTIME_PRODUCT=claude \"$HOME/.claude/hooks/session-start-healthcheck.sh\"",
          "statusMessage": "agent-runtime-kit: Check baseline health"
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "AGENT_RUNTIME_PRODUCT=claude \"$HOME/.claude/hooks/claude-pretool-sequence.py\"",
          "timeout": 250,
          "statusMessage": "agent-runtime-kit: Run mutation prerequisites and admission sequentially"
        }
      ]
    },
    {
      "matcher": "Write|Edit|NotebookEdit",
      "hooks": [
        {
          "type": "command",
          "command": "AGENT_RUNTIME_PRODUCT=claude \"$HOME/.claude/hooks/claude-pretool-sequence.py\"",
          "timeout": 250,
          "statusMessage": "agent-runtime-kit: Run edit prerequisites and admission sequentially"
        }
      ]
    },
    {
      "matcher": "MultiEdit",
      "hooks": [
        {
          "type": "command",
          "command": "AGENT_RUNTIME_PRODUCT=claude \"$HOME/.claude/hooks/claude-pretool-sequence.py\"",
          "timeout": 250,
          "statusMessage": "agent-runtime-kit: Run multi-edit prerequisites and admission sequentially"
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Bash|Write|Edit|NotebookEdit|MultiEdit",
      "hooks": [
        {
          "type": "command",
          "command": "AGENT_RUNTIME_PRODUCT=claude \"$HOME/.claude/hooks/session-coordination-guard.py\"",
          "timeout": 60,
          "statusMessage": "agent-runtime-kit: Complete managed session mutation"
        }
      ]
    }
  ],
  "PostToolUseFailure": [
    {
      "matcher": "Bash|Write|Edit|NotebookEdit|MultiEdit",
      "hooks": [
        {
          "type": "command",
          "command": "AGENT_RUNTIME_PRODUCT=claude \"$HOME/.claude/hooks/session-coordination-guard.py\"",
          "timeout": 60,
          "statusMessage": "agent-runtime-kit: Complete failed managed session mutation"
        }
      ]
    }
  ]
}
